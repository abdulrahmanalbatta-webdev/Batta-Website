// Cloudflare Workers (static assets): serves the built site from dist/; unknown paths get index.html so the
// Vue router handles them (the same job public/_redirects does on Cloudflare Pages)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "batta-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
